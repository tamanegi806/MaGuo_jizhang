/* !DESIGN-TOKENS: 全局设计令牌与基础设置（v1.9 微信原生风 + 麻将墨绿主题），改主题只改这里 */
page {
  /* —— 主题：牌桌呢绒墨绿（语义色保留微信原生值）—— */
  --color-primary: #176b46;
  --color-primary-pressed: #125438;
  --color-primary-tint: #eaf3ef; /* 淡绿底：选中态、金额区、卡片头 */
  --color-success: #07c160;
  --color-danger: #fa5151;
  --color-warning: #fa9d3a;
  --color-link: #576b95; /* 微信文字按钮蓝 */

  /* —— 文字（微信 8.x 三级灰阶）—— */
  --color-text: #191919;
  --color-text-secondary: #888888;
  --color-text-tertiary: #b2b2b2; /* 占位符、说明 */
  --color-text-inverse: #ffffff;

  /* —— 面 —— */
  --color-bg: #f2f2f2; /* 页面底 */
  --color-card: #ffffff; /* 卡片 */
  --color-fill: #f7f7f7; /* 次按钮、淡区块 */
  --color-pressed: #ececec; /* 按压态 */
  --color-mask: rgba(0, 0, 0, 0.55);

  /* —— 线 —— */
  --color-border: #e8e8e8; /* 控件描边 */
  --color-divider: rgba(0, 0, 0, 0.08); /* cell 分隔 hairline */

  /* —— 语义淡底（提示条、错误块）—— */
  --tint-success: rgba(7, 193, 96, 0.1);
  --tint-danger: rgba(250, 81, 81, 0.1);
  --tint-warning: rgba(250, 157, 58, 0.14);

  /* —— 字号：正文 17px / 副 15px / 说明 13px，数字单独一档 —— */
  --font-size-sm: 26rpx;
  --font-size-base: 30rpx;
  --font-size-lg: 34rpx;
  --font-size-xl: 40rpx;
  --font-size-num: 44rpx;

  /* —— 圆角与节奏 —— */
  --padding-base: 32rpx;
  --gap-card: 24rpx; /* 卡片间距 */
  --radius-base: 16rpx; /* 控件（8px） */
  --radius-card: 24rpx; /* 卡片 */
  --radius-avatar: 12rpx; /* 微信式圆角方形头像 */
  --radius-pill: 999rpx;
  --radius-sheet: 32rpx; /* 弹层顶部 */
  --cell-height: 104rpx; /* 微信 cell 56px 档 */
  --bar-height: 112rpx; /* 底部动作条 */

  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: var(--font-size-base);
  color: var(--color-text);
  background-color: var(--color-bg);
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

view,
text,
image {
  box-sizing: border-box;
}

.container {
  padding: var(--padding-base);
}

.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ---------- 卡片分组（微信「设置页」节奏）---------- */

.card {
  padding: var(--padding-base);
  border-radius: var(--radius-card);
  background-color: var(--color-card);
}

/* 卡内是 cell 列表时用：去掉内边距，由 cell 自己出左右 16px */
.card--flush {
  padding: 0;
}

.section-label {
  display: block;
  margin: 40rpx 0 12rpx 8rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

/* ---------- cell：一行 + 左侧缩进的 hairline ---------- */

.cell {
  position: relative;
  display: flex;
  align-items: center;
  min-height: var(--cell-height);
  padding: 0 var(--padding-base);
}

.cell::after {
  content: '';
  position: absolute;
  right: 0;
  bottom: 0;
  left: var(--padding-base);
  height: 1rpx;
  background-color: var(--color-divider);
}

.cell:last-child::after {
  display: none;
}

.cell--hover {
  background-color: var(--color-pressed);
}

/* ---------- 按钮：主（墨绿）/ 次（淡灰）/ 文字（微信蓝）/ 危险文字 ---------- */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx; /* ≥44px */
  padding: 0 32rpx;
  font-size: var(--font-size-lg);
  line-height: 1.4;
  border-radius: var(--radius-base);
}

/* 微信 button 自带 ::after 描边，统一抹掉由背景/文字承担层次 */
.btn::after {
  border: none;
}

.btn--primary {
  color: var(--color-text-inverse);
  background-color: var(--color-primary);
}

.btn--primary-hover {
  color: var(--color-text-inverse);
  background-color: var(--color-primary-pressed);
}

.btn--secondary {
  color: var(--color-text);
  background-color: var(--color-fill);
}

.btn--secondary-hover {
  background-color: var(--color-pressed);
}

.btn--text {
  color: var(--color-link);
  background-color: transparent;
}

.btn--danger {
  color: var(--color-danger);
  background-color: transparent;
}

.btn--block {
  width: 100%;
}

.btn[disabled] {
  opacity: 0.5;
}

/* ---------- 状态胶囊：淡底同色文字，不描边 ---------- */

.pill {
  padding: 6rpx 20rpx;
  font-size: var(--font-size-sm);
  line-height: 1.3;
  color: var(--color-success);
  background-color: var(--tint-success);
  border-radius: var(--radius-pill);
}

.pill--muted {
  color: var(--color-text-secondary);
  background-color: var(--color-fill);
}

.pill--primary {
  color: var(--color-primary);
  background-color: var(--color-primary-tint);
}

/* ---------- 顶部/底部 hairline（取代阴影，微信原生做法）---------- */

.hairline-top::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 1rpx;
  background-color: var(--color-divider);
}

/* ---------- 头像：圆角方形兜底底（图片未加载时为淡灰块）---------- */

.avatar {
  border-radius: var(--radius-avatar);
  background-color: var(--color-fill);
}

/* ---------- 底部动作条 ---------- */

.action-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  padding: 16rpx var(--padding-base);
  background-color: var(--color-card);
}

.action-bar .btn + .btn {
  margin-left: 16rpx;
}

/* ---------- 提示条 ---------- */

.notice {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  font-size: var(--font-size-base);
  border-radius: var(--radius-base);
}

.notice--warning {
  color: var(--color-text);
  background-color: var(--tint-warning);
}

.notice--danger {
  color: var(--color-danger);
  background-color: var(--tint-danger);
}
