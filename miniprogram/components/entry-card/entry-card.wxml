<view class="entry-card" catchtap="onTap">
  <view class="entry-card__main">
    <text class="entry-card__from">{{display.from}}</text>
    <text class="entry-card__arrow">→</text>
    <text class="entry-card__to">{{display.to}}</text>
  </view>
  <view class="entry-card__meta">
    <text wx:if="{{display.timeText}}" class="entry-card__time">{{display.timeText}}</text>
    <text class="entry-card__amount">{{display.amountText}}</text>
  </view>
</view>
