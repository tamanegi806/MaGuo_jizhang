/* invite-sheet — 底部弹层，适配安全区；按钮点击区域 ≥44px */
.invite-sheet {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
}

.invite-sheet__mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.invite-sheet__panel {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: var(--padding-base);
  padding-bottom: calc(var(--padding-base) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--padding-base) + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background-color: #ffffff;
}

.invite-sheet__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.invite-sheet__title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-text);
}

.invite-sheet__close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx; /* ≥44px */
  font-size: 40rpx;
  color: var(--color-text-secondary);
}

.invite-sheet__qr-area {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 420rpx;
  margin: 16rpx 0;
}

.invite-sheet__skeleton {
  width: 360rpx;
  height: 360rpx;
  border-radius: var(--radius-base);
  background: linear-gradient(90deg, var(--color-bg) 25%, #e8e8e8 37%, var(--color-bg) 63%);
  background-size: 400% 100%;
  animation: invite-sheet-skeleton 1.4s ease infinite;
}

@keyframes invite-sheet-skeleton {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}

.invite-sheet__qr-img {
  width: 360rpx;
  height: 360rpx;
}

.invite-sheet__qr-error {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.invite-sheet__qr-error-text {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
}

.invite-sheet__retry {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 160rpx;
  min-height: 96rpx; /* ≥44px */
  margin-top: 24rpx;
  padding: 0 32rpx;
  font-size: var(--font-size-base);
  color: var(--color-primary);
  border: 1rpx solid var(--color-primary);
  border-radius: var(--radius-base);
}

.invite-sheet__code-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 16rpx 0;
}

.invite-sheet__code-label {
  margin-right: 16rpx;
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
}

.invite-sheet__code {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
  color: var(--color-text);
}

.invite-sheet__copy {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 96rpx;
  min-height: 96rpx; /* ≥44px */
  margin-left: 24rpx;
  padding: 0 32rpx;
  font-size: var(--font-size-base);
  color: #ffffff;
  background-color: var(--color-primary);
  border-radius: var(--radius-base);
}

.invite-sheet__share {
  width: 100%;
  min-height: 96rpx; /* ≥44px */
  margin-top: 16rpx;
  font-size: var(--font-size-lg);
  color: #ffffff;
  background-color: var(--color-primary);
  border-radius: var(--radius-base);
}

.invite-sheet__hint {
  display: block;
  margin-top: 16rpx;
  text-align: center;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}
