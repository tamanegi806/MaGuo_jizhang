<view class="member-picker">
  <text wx:if="{{label}}" class="member-picker__label">{{label}}</text>
  <view wx:if="{{options.length === 0}}" class="member-picker__empty">暂无可选成员</view>
  <view wx:else class="member-picker__list">
    <view
      wx:for="{{options}}"
      wx:key="openid"
      class="member-picker__item {{item.selected ? 'member-picker__item--selected' : ''}}"
      data-openid="{{item.openid}}"
      bindtap="onSelect"
    >
      <image class="member-picker__avatar" src="{{item.avatar}}" mode="aspectFill" />
      <text class="member-picker__name">{{item.displayName}}</text>
      <text wx:if="{{item.isOwner}}" class="member-picker__owner-tag">房主</text>
      <text wx:if="{{item.selected}}" class="member-picker__check">✓</text>
    </view>
  </view>
</view>
