/* member-picker — 复用 app.wxss 设计变量 */
.member-picker__label {
  display: block;
  margin-bottom: 16rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.member-picker__empty {
  padding: 32rpx;
  text-align: center;
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
}

.member-picker__item {
  display: flex;
  align-items: center;
  min-height: 96rpx; /* ≥44px 点击区域 */
  padding: 8rpx var(--padding-base);
  border-bottom: 1rpx solid var(--color-border);
}

.member-picker__item--selected {
  background-color: rgba(24, 144, 255, 0.06);
}

.member-picker__avatar {
  width: 64rpx;
  height: 64rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background-color: var(--color-bg);
}

.member-picker__name {
  flex: 1;
  font-size: var(--font-size-base);
  color: var(--color-text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.member-picker__owner-tag {
  margin-left: 12rpx;
  padding: 4rpx 12rpx;
  font-size: var(--font-size-sm);
  color: var(--color-primary);
  border: 1rpx solid var(--color-primary);
  border-radius: var(--radius-base);
}

.member-picker__check {
  margin-left: 16rpx;
  font-size: var(--font-size-lg);
  color: var(--color-primary);
}
