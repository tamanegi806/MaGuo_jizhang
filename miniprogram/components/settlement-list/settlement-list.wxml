<view class="settlement-list">
  <view wx:if="{{rows.length === 0}}" class="settlement-list__empty">暂无结算数据</view>
  <view wx:else class="settlement-list__rows">
    <view wx:for="{{rows}}" wx:key="openid" class="settlement-list__row">
      <view class="settlement-list__who">
        <text class="settlement-list__name">{{item.displayName}}</text>
        <text wx:if="{{item.isOwner}}" class="settlement-list__owner-tag">房主</text>
      </view>
      <text class="settlement-list__amount settlement-list__amount--{{item.tone}}">{{item.signedText}}</text>
    </view>
  </view>
</view>
