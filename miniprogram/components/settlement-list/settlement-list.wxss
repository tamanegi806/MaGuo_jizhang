/* settlement-list — 复用 app.wxss 设计变量；符号已在文本中，颜色仅作辅助 */
.settlement-list__empty {
  padding: 32rpx;
  text-align: center;
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
}

.settlement-list__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 8rpx var(--padding-base);
  border-bottom: 1rpx solid var(--color-border);
}

.settlement-list__who {
  display: flex;
  align-items: center;
  flex: 1;
  overflow: hidden;
}

.settlement-list__name {
  font-size: var(--font-size-base);
  color: var(--color-text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.settlement-list__owner-tag {
  margin-left: 12rpx;
  padding: 4rpx 12rpx;
  font-size: var(--font-size-sm);
  color: var(--color-primary);
  border: 1rpx solid var(--color-primary);
  border-radius: var(--radius-base);
}

.settlement-list__amount {
  margin-left: 16rpx;
  font-size: var(--font-size-lg);
}

.settlement-list__amount--plus {
  color: var(--color-danger); /* 正数红 */
}

.settlement-list__amount--minus {
  color: var(--color-success); /* 负数绿 */
}

.settlement-list__amount--zero {
  color: var(--color-text-secondary); /* 零灰 */
}
