/* state-view — 加载/错误/空态；只复用 app.wxss 的 CSS 变量 */
.state-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx var(--padding-base);
}

.state-view__loading,
.state-view__error,
.state-view__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.state-view__spinner {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 24rpx;
  border: 6rpx solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: state-view-spin 0.9s linear infinite;
}

@keyframes state-view-spin {
  to {
    transform: rotate(360deg);
  }
}

/* 状态图标：淡色圆底取代描边（微信空态常见做法） */
.state-view__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 24rpx;
  font-size: 48rpx;
  line-height: 1;
  color: var(--color-warning);
  background-color: var(--tint-warning);
  border-radius: 50%;
}

.state-view__icon--empty {
  color: var(--color-text-tertiary);
  background-color: var(--color-fill);
}

.state-view__text {
  font-size: var(--font-size-base);
  line-height: 1.6;
  color: var(--color-text-secondary);
}

.state-view__retry {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 200rpx;
  min-height: 96rpx; /* ≥44px */
  margin-top: 32rpx;
  padding: 0 48rpx;
  font-size: var(--font-size-base);
  color: var(--color-primary);
  background-color: var(--color-primary-tint);
  border-radius: var(--radius-base);
}
