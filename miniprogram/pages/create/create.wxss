.form {
  margin-top: 32rpx;
}

.form__label {
  display: block;
  margin-bottom: 16rpx;
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
}

.form__input {
  min-height: 96rpx; /* ≥44px */
  padding: 0 24rpx;
  font-size: var(--font-size-lg);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-base);
  background-color: #ffffff;
}

.form__error {
  display: block;
  margin-top: 8rpx;
  padding-left: 8rpx;
  font-size: var(--font-size-sm);
  color: var(--color-danger);
}

.submit-error {
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  font-size: var(--font-size-base);
  color: var(--color-danger);
  background-color: rgba(255, 77, 79, 0.08);
  border-radius: var(--radius-base);
}

.submit {
  width: 100%;
  min-height: 96rpx; /* ≥44px */
  margin-top: 48rpx;
  font-size: var(--font-size-lg);
  border-radius: var(--radius-base);
}

.tip {
  display: block;
  margin-top: 24rpx;
  text-align: center;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}
