<view class="container">
  <state-view wx:if="{{loading}}" type="loading" />
  <state-view
    wx:elif="{{error}}"
    type="error"
    text="{{error.message}}"
    bind:retry="tapRetry"
  />

  <block wx:else>
    <view class="head">
      <text class="head__title">记一笔</text>
      <view class="head__done" bindtap="tapDone">完成</view>
    </view>

    <!-- v1.6：付款人固定为自己，不可选择（只允许「自己→他人」） -->
    <view class="payer-block">
      <text class="payer-block__label">付款人（输家）</text>
      <view class="payer-block__body">
        <image class="payer-block__avatar" src="{{meAvatar}}" mode="aspectFill" />
        <text class="payer-block__name">{{meName}}</text>
        <text class="payer-block__hint">只能记你付出去的账</text>
      </view>
    </view>

    <view class="picker-block">
      <member-picker
        members="{{members}}"
        valueOpenid="{{toOpenid}}"
        excludeOpenid="{{fromOpenid}}"
        label="收款人（赢家）"
        bind:change="onToChange"
      />
    </view>

    <view class="amount-block">
      <text class="amount-block__label">金额（元）</text>
      <amount-input
        value="{{amountValue}}"
        disabled="{{submitting}}"
        bind:change="onAmountChange"
      />
    </view>

    <view wx:if="{{preview.fromName && preview.toName}}" class="preview">
      <text class="preview__line">{{preview.fromName}} 付给 {{preview.toName}}</text>
      <text class="preview__amount">{{preview.amountText}}</text>
    </view>

    <view wx:if="{{saveError}}" class="save-error">
      <text>{{saveError}}</text>
    </view>

    <button
      class="save"
      type="primary"
      loading="{{submitting}}"
      disabled="{{!canSave || submitting}}"
      bindtap="onSave"
    >{{submitting ? '保存中…' : '保存'}}</button>
  </block>
</view>
