.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
}

.head__title {
  font-size: 40rpx;
  font-weight: 600;
}

.head__done {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 96rpx;
  min-height: 88rpx; /* ≥44px */
  padding: 0 24rpx;
  font-size: var(--font-size-base);
  color: var(--color-primary);
}

.picker-block {
  margin-top: 16rpx;
  border-radius: var(--radius-base);
  background-color: #ffffff;
}

.swap {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx; /* ≥44px */
  color: var(--color-primary);
}

.swap--disabled {
  color: var(--color-text-secondary);
  opacity: 0.5;
}

.swap__icon {
  margin-right: 8rpx;
  font-size: var(--font-size-lg);
}

.swap__text {
  font-size: var(--font-size-base);
}

.amount-block {
  margin-top: 32rpx;
}

.amount-block__label {
  display: block;
  margin-bottom: 16rpx;
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
}

.preview {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 32rpx;
  padding: 24rpx;
  border-radius: var(--radius-base);
  background-color: rgba(24, 144, 255, 0.06);
}

.preview__line {
  font-size: var(--font-size-base);
  color: var(--color-text);
}

.preview__amount {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-danger);
}

.save-error {
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  font-size: var(--font-size-base);
  color: var(--color-danger);
  background-color: rgba(255, 77, 79, 0.08);
  border-radius: var(--radius-base);
}

.save {
  width: 100%;
  min-height: 96rpx; /* ≥44px */
  margin-top: 40rpx;
  font-size: var(--font-size-lg);
  border-radius: var(--radius-base);
}
