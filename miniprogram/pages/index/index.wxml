<view class="container index-page">
  <view class="card header" bindtap="tapProfile" hover-class="header--hover" hover-stay-time="60">
    <image
      class="header__avatar"
      src="{{user.avatarFileID || ''}}"
      mode="aspectFill"
    />
    <text class="header__title">{{user.nickname || '未设置昵称'}}</text>
    <text class="header__chevron">›</text>
  </view>

  <state-view wx:if="{{loading && rooms.length === 0}}" type="loading" />
  <state-view
    wx:elif="{{error && rooms.length === 0}}"
    type="error"
    text="{{error.message}}"
    bind:retry="tapRetry"
  />
  <state-view wx:elif="{{!loading && rooms.length === 0}}" type="empty" text="还没有牌局，创建一个吧" />

  <block wx:if="{{rooms.length > 0}}">
    <text class="section-label">我的牌局</text>
    <view class="room-list">
      <navigator
        wx:for="{{rooms}}"
        wx:key="roomId"
        url="/pages/room/room?id={{item.roomId}}"
        class="card room-card"
        hover-class="room-card--hover"
        hover-stay-time="60"
      >
        <view class="room-card__main">
          <text class="room-card__time">{{item.createdAtStr}}</text>
          <text class="pill room-card__status {{item.status === 'ended' ? 'pill--muted' : ''}}">{{item.statusText}}</text>
        </view>
        <text class="room-card__meta">{{item.memberCount}} 人</text>
      </navigator>
      <view wx:if="{{loadingMore}}" class="room-list__more">加载中…</view>
      <view wx:elif="{{!hasMore}}" class="room-list__more">没有更多了</view>
    </view>
  </block>

  <view class="action-bar hairline-top safe-area-bottom">
    <button class="btn btn--secondary btn--block" hover-class="btn--secondary-hover" bindtap="tapJoin">加入牌局</button>
    <button class="btn btn--primary btn--block" hover-class="btn--primary-hover" bindtap="tapCreate" loading="{{creating}}" disabled="{{creating}}">＋ 创建牌局</button>
  </view>
</view>
