.header {
  display: flex;
  align-items: center;
  padding: 8rpx 0 24rpx;
}

.header__avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: var(--color-border);
}

.header__title {
  flex: 1;
  margin-left: 20rpx;
  font-size: 36rpx;
  font-weight: 600;
}

.header__join {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 160rpx;
  min-height: 88rpx; /* ≥44px */
  padding: 0 24rpx;
  font-size: var(--font-size-base);
  color: var(--color-primary);
  border: 1rpx solid var(--color-primary);
  border-radius: var(--radius-base);
}

.room-card {
  display: block;
  margin-bottom: 24rpx;
  padding: var(--padding-base);
  border-radius: var(--radius-base);
  background-color: #ffffff;
}

.room-card--hover {
  opacity: 0.85;
}

.room-card__main {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.room-card__name {
  flex: 1;
  font-size: var(--font-size-lg);
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.room-card__status {
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  font-size: var(--font-size-sm);
  color: var(--color-success);
  border: 1rpx solid var(--color-success);
  border-radius: var(--radius-base);
}

.room-card__status--ended {
  color: var(--color-text-secondary);
  border-color: var(--color-border);
}

.room-card__meta {
  display: block;
  margin-top: 12rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.room-list__more {
  padding: 24rpx;
  text-align: center;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.footer {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 24rpx var(--padding-base);
  background-color: #ffffff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.footer__create {
  width: 100%;
  min-height: 96rpx; /* ≥44px */
  font-size: var(--font-size-lg);
  border-radius: var(--radius-base);
}
