/* 首页 — 结构与配色走 app.wxss 的令牌与工具类（card / section-label / pill / btn / action-bar） */
.index-page {
  padding-bottom: 216rpx; /* 底部动作条留白 */
}

/* 顶部资料行（点整行进「我的」） */
.header {
  display: flex;
  align-items: center;
  padding: 28rpx var(--padding-base);
}

.header--hover {
  background-color: var(--color-pressed);
}

.header__avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-avatar);
  background-color: var(--color-fill);
}

.header__title {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  font-size: var(--font-size-xl);
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.header__chevron {
  flex-shrink: 0;
  margin-left: 8rpx;
  font-size: 44rpx;
  line-height: 1;
  color: var(--color-text-tertiary);
}

.room-card {
  display: block;
  margin-bottom: var(--gap-card);
}

.room-card--hover {
  background-color: var(--color-pressed);
}

.room-card__main {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.room-card__time {
  flex: 1;
  min-width: 0;
  font-size: var(--font-size-lg);
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.room-card__status {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.room-card__meta {
  display: block;
  margin-top: 12rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.room-list__more {
  padding: 24rpx;
  text-align: center;
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}
