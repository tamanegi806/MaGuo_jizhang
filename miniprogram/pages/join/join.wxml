<view class="container join-page">
  <view wx:if="{{autoJoining && submitting}}" class="card auto-join">
    <text class="auto-join__text">正在加入牌局…</text>
    <text class="auto-join__code">{{code}}</text>
  </view>

  <block wx:else>
    <text class="section-label join-label">输入 4 位邀请码</text>
    <view class="card form">
      <input
        class="form__input"
        value="{{code}}"
        type="number"
        placeholder="1234"
        placeholder-class="form__placeholder"
        maxlength="4"
        disabled="{{submitting}}"
        bindinput="onInputCode"
      />
      <view wx:if="{{error}}" class="form__error-box">
        <text class="form__error">{{error.message}}</text>
      </view>
    </view>

    <button
      class="btn btn--primary btn--block submit"
      hover-class="btn--primary-hover"
      loading="{{submitting}}"
      disabled="{{submitting}}"
      bindtap="tapJoin"
    >{{submitting ? '加入中…' : '加入牌局'}}</button>
  </block>

  <text class="tip">也可以直接点击好友分享的卡片，或使用微信扫一扫小程序码加入。</text>
</view>
