.auto-join {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 0;
}

.auto-join__text {
  font-size: var(--font-size-lg);
  color: var(--color-text);
}

.auto-join__code {
  margin-top: 16rpx;
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
  color: var(--color-primary);
}

.form {
  margin-top: 32rpx;
}

.form__label {
  display: block;
  margin-bottom: 16rpx;
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
}

.form__input {
  min-height: 96rpx; /* ≥44px */
  padding: 0 24rpx;
  font-size: 40rpx;
  letter-spacing: 4rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-base);
  background-color: #ffffff;
}

.form__error-box {
  margin-top: 16rpx;
  padding: 16rpx 24rpx;
  background-color: rgba(255, 77, 79, 0.08);
  border-radius: var(--radius-base);
}

.form__error {
  font-size: var(--font-size-base);
  color: var(--color-danger);
}

.submit {
  width: 100%;
  min-height: 96rpx; /* ≥44px */
  margin-top: 48rpx;
  font-size: var(--font-size-lg);
  border-radius: var(--radius-base);
}

.tip {
  display: block;
  margin-top: 48rpx;
  text-align: center;
  font-size: var(--font-size-sm);
  line-height: 1.6;
  color: var(--color-text-secondary);
}
