/* 加入牌局 — 结构与配色走 app.wxss 的令牌与工具类 */
.join-page {
  padding-top: 16rpx;
}

.auto-join {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx var(--padding-base);
}

.auto-join__text {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
}

.auto-join__code {
  margin-top: 24rpx;
  font-size: var(--font-size-num);
  font-weight: 600;
  letter-spacing: 8rpx;
  text-indent: 8rpx;
  color: var(--color-primary);
}

/* 首屏标题不再需要 40rpx 上边距 */
.join-label {
  margin-top: 16rpx;
}

.form__input {
  height: 120rpx;
  font-size: var(--font-size-num);
  font-weight: 600;
  letter-spacing: 10rpx;
  text-indent: 10rpx;
  text-align: center;
  color: var(--color-text);
}

.form__placeholder {
  font-weight: 400;
  letter-spacing: 4rpx;
  color: var(--color-text-tertiary);
}

.form__error-box {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background-color: var(--tint-danger);
  border-radius: var(--radius-base);
}

.form__error {
  font-size: var(--font-size-base);
  color: var(--color-danger);
}

.submit {
  margin-top: 48rpx;
}

.tip {
  display: block;
  margin-top: 40rpx;
  padding: 0 24rpx;
  text-align: center;
  font-size: var(--font-size-sm);
  line-height: 1.6;
  color: var(--color-text-tertiary);
}
