<view class="container profile-page">
  <view class="avatar-area">
    <button class="avatar-btn" hover-class="avatar-btn--hover" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image
        wx:if="{{avatarTempPath || avatarFileID}}"
        class="avatar-btn__img"
        src="{{avatarTempPath || avatarFileID}}"
        mode="aspectFill"
      />
      <text wx:else class="avatar-btn__placeholder">选择头像</text>
    </button>
    <text wx:if="{{uploading}}" class="avatar-area__status">头像上传中…</text>
  </view>

  <view class="card form">
    <view class="form__row">
      <text class="form__label">昵称</text>
      <input
        class="form__input"
        type="nickname"
        value="{{nickname}}"
        placeholder="点击填写微信昵称"
        placeholder-class="form__placeholder"
        maxlength="20"
        disabled="{{submitting}}"
        bindinput="onInputNickname"
        bindblur="onInputNickname"
      />
    </view>
    <text wx:if="{{nicknameError}}" class="form__error">{{nicknameError}}</text>
  </view>

  <view wx:if="{{error}}" class="notice notice--danger page-error">
    <text>{{error.message}}</text>
  </view>

  <button
    class="btn btn--primary btn--block save"
    hover-class="btn--primary-hover"
    loading="{{submitting}}"
    disabled="{{submitting || uploading}}"
    bindtap="tapSave"
  >{{submitting ? '保存中…' : '保存并进入'}}</button>

  <view wx:if="{{isInitial}}" class="later" bindtap="tapLater">
    <text class="later__text">稍后再说</text>
  </view>
  <view wx:else class="back" bindtap="tapBack">
    <text class="back__text">返回</text>
  </view>

  <text class="tip">昵称与头像只展示给同一牌局里的成员，用来区分「谁给谁记账」；不填则由系统用「玩家+编号」代替。</text>

  <view class="privacy" hover-class="privacy--hover" bindtap="tapPrivacyContract">
    <text class="privacy__text">《小程序用户隐私保护指引》</text>
  </view>
</view>
