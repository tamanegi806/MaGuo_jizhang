/* 完善资料 — 结构与配色走 app.wxss 的令牌与工具类（card / cell / btn / notice） */
.profile-page {
  padding-top: 64rpx;
}

.avatar-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 头像选择按钮：微信圆角方形 + 虚线占位框 */
.avatar-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  padding: 0;
  background-color: var(--color-fill);
  border: 2rpx dashed var(--color-border);
  border-radius: var(--radius-avatar);
}

.avatar-btn::after {
  border: none;
}

.avatar-btn--hover {
  background-color: var(--color-pressed);
}

.avatar-btn__img {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-avatar);
}

.avatar-btn__placeholder {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.avatar-area__status {
  display: block;
  margin-top: 16rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

/* 昵称一行：左标签右输入（微信「编辑个人信息」节奏） */
.form {
  margin-top: 64rpx;
  padding: 0;
}

.form__row {
  display: flex;
  align-items: center;
  min-height: var(--cell-height);
  padding: 0 var(--padding-base);
}

.form__label {
  flex-shrink: 0;
  margin-right: 24rpx;
  font-size: var(--font-size-lg);
  color: var(--color-text);
}

.form__input {
  flex: 1;
  min-width: 0;
  font-size: var(--font-size-lg);
  text-align: right;
  color: var(--color-text);
}

.form__placeholder {
  color: var(--color-text-tertiary);
}

.form__error {
  display: block;
  padding: 0 var(--padding-base) 20rpx;
  font-size: var(--font-size-sm);
  color: var(--color-danger);
}

.page-error {
  margin-top: var(--gap-card);
}

.save {
  margin-top: 64rpx;
}

/* 文字按钮（微信蓝链） */
.later,
.back {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx; /* ≥44px */
  margin-top: 8rpx;
}

.later__text,
.back__text {
  font-size: var(--font-size-base);
  color: var(--color-link);
}

.tip {
  display: block;
  margin-top: 32rpx;
  padding: 0 24rpx;
  text-align: center;
  font-size: var(--font-size-sm);
  line-height: 1.6;
  color: var(--color-text-tertiary);
}
