.profile-page {
  padding-top: 48rpx;
  text-align: center;
}

.avatar-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  padding: 0;
  border-radius: 50%;
  background-color: var(--color-bg);
  border: 1rpx solid var(--color-border);
}

.avatar-btn__img {
  width: 158rpx;
  height: 158rpx;
  border-radius: 50%;
}

.avatar-btn__placeholder {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.avatar-area__status {
  display: block;
  margin-top: 16rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.form {
  margin-top: 48rpx;
  text-align: left;
}

.form__label {
  display: block;
  margin-bottom: 16rpx;
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
}

.form__input {
  min-height: 96rpx; /* ≥44px */
  padding: 0 24rpx;
  font-size: var(--font-size-lg);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-base);
  background-color: #ffffff;
}

.form__error {
  display: block;
  margin-top: 8rpx;
  padding-left: 8rpx;
  font-size: var(--font-size-sm);
  color: var(--color-danger);
}

.page-error {
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  font-size: var(--font-size-base);
  color: var(--color-danger);
  background-color: rgba(255, 77, 79, 0.08);
  border-radius: var(--radius-base);
  text-align: left;
}

.save {
  width: 100%;
  min-height: 96rpx; /* ≥44px */
  margin-top: 48rpx;
  font-size: var(--font-size-lg);
  border-radius: var(--radius-base);
}

.later,
.back {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx; /* ≥44px */
  margin-top: 16rpx;
}

.later__text,
.back__text {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
}

.tip {
  display: block;
  margin-top: 32rpx;
  font-size: var(--font-size-sm);
  line-height: 1.6;
  color: var(--color-text-secondary);
}
