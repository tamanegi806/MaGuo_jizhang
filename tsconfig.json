{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "types": ["miniprogram-api-typings"]
  },
  "include": ["miniprogram/**/*.js", "shared/**/*.js"],
  "exclude": ["node_modules", "miniprogram/shared"]
}
